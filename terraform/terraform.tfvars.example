# Copy this file to terraform.tfvars and fill in your values

# Required: Cloudflare API Token
# Create at: https://dash.cloudflare.com/profile/api-tokens
# Required permissions: Account.Cloudflare Pages (Edit), Zone.DNS (Edit)
cloudflare_api_token = "your-api-token-here"

# Required: Cloudflare Account ID
# Found at: https://dash.cloudflare.com/ (in the URL or sidebar)
cloudflare_account_id = "your-account-id-here"

# Required: Cloudflare Zone ID for secret0.com
# Found at: https://dash.cloudflare.com/ -> select domain -> Overview -> Zone ID
cloudflare_zone_id = "your-zone-id-here"

# Optional: Customize project settings
project_name       = "secretzero-docs"
domain_name        = "docs.secret0.com"
production_branch  = "main"
build_command      = "mkdocs build"
build_output_dir   = "site"

# Optional: GitHub Integration
enable_github_integration = true
github_repo_owner         = "zloeber"
github_repo_name          = "SecretZero"

# Optional: Preview deployments
preview_branch_includes = ["*"]
preview_branch_excludes = []

# Optional: Web Analytics
enable_web_analytics = false
# web_analytics_token = "your-analytics-token"
