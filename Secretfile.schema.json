    },
    "labels": {
      "additionalProperties": true,
      "title": "Labels",
      "type": "object"
    },
    "annotations": {
      "additionalProperties": true,
      "title": "Annotations",
      "type": "object"
    },
    "config": {
      "anyOf": [
        {
          "$ref": "#/$defs/AppConfig"
        },
        {
